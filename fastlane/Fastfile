default_platform(:ios)

require "shellwords"

def signing_dir
  File.expand_path("../build/ios/signing", __dir__)
end

def release_metadata_dir
  File.expand_path("../build/ios/metadata", __dir__)
end

def generated_release_notes_path
  File.expand_path("../build/ios/release-notes.txt", __dir__)
end

def release_support_url
  "https://www.digitaltolk.se/en/contact"
end

def release_copyright
  "#{Time.now.utc.year} Digital Interpretations Scandinavia AB"
end

def signing_certificate_path
  File.join(signing_dir, "certificate.p12")
end

def signing_profile_path
  File.join(signing_dir, "profile.mobileprovision")
end

def signing_profile_plist_path
  File.join(signing_dir, "profile.plist")
end

def signing_keychain_name
  "build.keychain"
end

def app_bundle_id
  "com.digitaltolk.ex.mobile"
end

def ios_project_path
  "ios/App/App.xcodeproj"
end

# The App Store never lets a shipped iPad app drop iPad support again, so catch an
# accidental revert to an iPhone-only target before it uploads.
def assert_universal_device_family
  project_file = File.expand_path("../#{ios_project_path}/project.pbxproj", __dir__)
  device_families = File.read(project_file).scan(/TARGETED_DEVICE_FAMILY = "?([\d,]+)"?;/).flatten
  unless device_families.any? && device_families.all? { |family| family == "1,2" }
    UI.user_error!("App target must support iPhone and iPad. Set TARGETED_DEVICE_FAMILY to \"1,2\", got #{device_families.inspect}.")
  end
end

# Screenshots are uploaded wholesale (`overwrite_screenshots` replaces the whole
# listing set), so a release that did not touch them must not rewrite them —
# and must not re-upload identical images on every tag. Compare the committed
# screenshots against the previous release tag; with no previous tag there is
# nothing to compare, so upload.
def screenshots_changed_since_previous_release?(tag)
  root = File.expand_path("..", __dir__)
  previous = sh("git -C #{root.shellescape} describe --tags --abbrev=0 --match 'v*' #{tag.shellescape}^ 2>/dev/null || true", log: false).strip
  if previous.empty?
    UI.message("No previous release tag: uploading screenshots.")
    return true
  end

  changed = sh(
    "git -C #{root.shellescape} diff --name-only #{previous.shellescape}..#{tag.shellescape} -- fastlane/screenshots",
    log: false
  ).strip
  if changed.empty?
    UI.message("Screenshots unchanged since #{previous}: leaving the App Store listing's screenshots alone.")
    false
  else
    UI.message("Screenshots changed since #{previous}: uploading them.")
    true
  end
end

def ci_build_number
  Time.now.utc.strftime("%Y%m%d%H%M%S")
end

def release_version_from_tag
  tag = ENV.fetch("GITHUB_REF_NAME", "")
  match = tag.match(/\Av(\d+\.\d+\.\d+)\z/)
  UI.user_error!("Release tags must use vN.N.N format, got #{tag.inspect}") unless match

  version = match[1]
  expected_version = next_marketing_version
  UI.user_error!("Release tag #{tag.inspect} does not match VERSION #{expected_version.inspect}") unless version == expected_version

  version
end

def next_marketing_version
  version_file = File.expand_path("../VERSION", __dir__)
  version = File.read(version_file).strip
  UI.user_error!("VERSION must use N.N.N format, got #{version.inspect}") unless version.match?(/\A\d+\.\d+\.\d+\z/)

  version
end

def pr_marketing_version
  next_marketing_version
end

def provisioning_profile_value(key)
  sh(
    "/usr/bin/security cms -D -i #{signing_profile_path.shellescape} > #{signing_profile_plist_path.shellescape}",
    log: false
  )
  sh(
    "/usr/libexec/PlistBuddy -c #{("Print :" + key).shellescape} #{signing_profile_plist_path.shellescape}",
    log: false
  ).strip
end

def ci_code_signing_xcargs
  Shellwords.join(
    [
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=Apple Distribution",
      "DEVELOPMENT_TEAM=#{ENV.fetch("IOS_DEVELOPMENT_TEAM")}",
      "PROVISIONING_PROFILE_SPECIFIER=#{ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")}"
    ]
  )
end

def ci_export_options
  {
    method: "app-store",
    signingStyle: "manual",
    teamID: ENV.fetch("IOS_DEVELOPMENT_TEAM"),
    provisioningProfiles: {
      app_bundle_id => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    }
  }
end

def cleanup_ci_signing
  FileUtils.rm_f(signing_certificate_path)
  FileUtils.rm_f(signing_profile_path)
  FileUtils.rm_f(signing_profile_plist_path)
  FileUtils.rm_rf(signing_dir)
  FileUtils.rm_rf(release_metadata_dir)
  delete_keychain(name: signing_keychain_name) if File.exist?(File.expand_path("~/Library/Keychains/#{signing_keychain_name}-db"))
end

def prepare_release_metadata
  en_us_dir = File.join(release_metadata_dir, "en-US")

  FileUtils.rm_rf(release_metadata_dir)
  FileUtils.mkdir_p(en_us_dir)
  File.write(File.join(release_metadata_dir, "copyright.txt"), release_copyright)
  File.write(File.join(en_us_dir, "support_url.txt"), release_support_url)
  File.write(
    File.join(en_us_dir, "release_notes.txt"),
    File.exist?(generated_release_notes_path) ? File.read(generated_release_notes_path) : "Bug fixes and performance improvements.\n"
  )
end

def android_signing_dir
  File.expand_path("../build/android/signing", __dir__)
end

def android_keystore_path
  File.join(android_signing_dir, "upload.jks")
end

def android_metadata_dir
  File.expand_path("../build/android/metadata", __dir__)
end

def android_aab_path
  File.expand_path("../android/app/build/outputs/bundle/release/app-release.aab", __dir__)
end

# Play wants a strictly increasing integer below 2^31. Minutes since the epoch
# (about 30 million today) outranks every earlier upload and stays in range
# for a few thousand years.
def android_version_code
  (Time.now.utc.to_i / 60).to_s
end

def install_android_signing
  FileUtils.mkdir_p(android_signing_dir)
  File.binwrite(android_keystore_path, Base64.decode64(ENV.fetch("ANDROID_KEYSTORE_BASE64")))
  UI.user_error!("Could not write #{android_keystore_path}") unless File.exist?(android_keystore_path)
  %w[ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD].each { |name| ENV.fetch(name) }
  ENV["ANDROID_KEYSTORE_PATH"] = android_keystore_path
end

def cleanup_android_signing
  FileUtils.rm_rf(android_signing_dir)
  FileUtils.rm_rf(android_metadata_dir)
end

# supply reads a release's notes from <metadata>/<locale>/changelogs/<versionCode>.txt;
# Play caps them at 500 characters.
def prepare_android_changelog(version_code)
  changelog_dir = File.join(android_metadata_dir, "en-US", "changelogs")
  FileUtils.rm_rf(android_metadata_dir)
  FileUtils.mkdir_p(changelog_dir)
  notes = File.exist?(generated_release_notes_path) ? File.read(generated_release_notes_path) : "Bug fixes and performance improvements.\n"
  File.write(File.join(changelog_dir, "#{version_code}.txt"), "#{notes.strip[0, 500]}\n")
end

# Builds the signed release bundle; build.gradle reads the version pair from
# the environment. Returns the version code it used.
def build_android_bundle(version_name)
  version_code = android_version_code
  ENV["ANDROID_VERSION_CODE"] = version_code
  ENV["ANDROID_VERSION_NAME"] = version_name
  gradle(task: "bundle", build_type: "Release", project_dir: "android")
  UI.user_error!("Gradle produced no bundle at #{android_aab_path}") unless File.exist?(android_aab_path)
  version_code
end

platform :android do
  desc "Upload a PR build to the Play internal track"
  lane :play_internal do
    install_android_signing
    version_code = build_android_bundle(pr_marketing_version)
    upload_to_play_store(
      package_name: app_bundle_id,
      track: "internal",
      aab: android_aab_path,
      version_code: version_code.to_i,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload a tagged build to Google Play"
  lane :play_release do
    install_android_signing
    version_code = build_android_bundle(release_version_from_tag)
    prepare_android_changelog(version_code)
    upload_to_play_store(
      package_name: app_bundle_id,
      track: ENV.fetch("PLAY_TRACK", "production"),
      aab: android_aab_path,
      version_code: version_code.to_i,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: android_metadata_dir,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end

  after_all do
    cleanup_android_signing
  end

  error do
    cleanup_android_signing
  end
end

platform :ios do
  desc "Upload a PR build to TestFlight"
  lane :testflight_pr do
    setup_ci
    assert_universal_device_family
    install_ci_signing
    set_pr_marketing_version
    set_ci_build_number
    build_app(
      project: ios_project_path,
      scheme: "App",
      export_method: "app-store",
      xcargs: ci_code_signing_xcargs,
      export_options: ci_export_options,
      output_directory: "build/ios",
      output_name: "ex-mobile.ipa"
    )
    upload_to_testflight(
      api_key: app_store_api_key,
      changelog: "PR #{ENV['GITHUB_REF_NAME']} commit #{ENV['GITHUB_SHA']}",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload a tagged build to App Store Connect"
  lane :app_store_release do
    setup_ci
    assert_universal_device_family
    install_ci_signing
    set_release_marketing_version
    set_ci_build_number
    prepare_release_metadata
    screenshots_changed = screenshots_changed_since_previous_release?(ENV.fetch("GITHUB_REF_NAME"))
    build_app(
      project: ios_project_path,
      scheme: "App",
      export_method: "app-store",
      xcargs: ci_code_signing_xcargs,
      export_options: ci_export_options,
      output_directory: "build/ios",
      output_name: "ex-mobile.ipa"
    )
    upload_to_app_store(
      api_key: app_store_api_key,
      metadata_path: release_metadata_dir,
      copyright: release_copyright,
      skip_metadata: false,
      skip_screenshots: !screenshots_changed,
      overwrite_screenshots: screenshots_changed,
      precheck_include_in_app_purchases: false,
      automatic_release: true,
      force: true,
      submit_for_review: true
    )
  end

  private_lane :app_store_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
      duration: 1200
    )
  end

  private_lane :install_ci_signing do
    create_keychain(
      name: signing_keychain_name,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "ci-keychain-password"),
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    FileUtils.mkdir_p(signing_dir)
    File.binwrite(signing_certificate_path, Base64.decode64(ENV.fetch("IOS_CERTIFICATE_P12_BASE64")))
    File.binwrite(signing_profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE_BASE64")))
    UI.user_error!("Could not write #{signing_certificate_path}") unless File.exist?(signing_certificate_path)
    UI.user_error!("Could not write #{signing_profile_path}") unless File.exist?(signing_profile_path)

    import_certificate(
      certificate_path: signing_certificate_path,
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
      keychain_name: signing_keychain_name,
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "ci-keychain-password")
    )
    install_provisioning_profile(path: signing_profile_path)

    ENV["IOS_DEVELOPMENT_TEAM"] = provisioning_profile_value("TeamIdentifier:0")
    ENV["IOS_PROVISIONING_PROFILE_NAME"] = provisioning_profile_value("Name")
  end

  private_lane :set_ci_build_number do
    increment_build_number(
      xcodeproj: ios_project_path,
      build_number: ci_build_number
    )
  end

  private_lane :set_release_marketing_version do
    increment_version_number(
      xcodeproj: ios_project_path,
      version_number: release_version_from_tag
    )
  end

  private_lane :set_pr_marketing_version do
    increment_version_number(
      xcodeproj: ios_project_path,
      version_number: pr_marketing_version
    )
  end

  after_all do
    cleanup_ci_signing
  end

  error do
    cleanup_ci_signing
  end
end
